{
  "name": "@ferment-ai/demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "module": "./dist/src/main.js",
  "types": "./dist/src/main.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/main.ts",
      "types": "./dist/src/main.d.ts",
      "import": "./dist/src/main.js",
      "default": "./dist/src/main.js"
    }
  },
  "nx": {
    "sourceRoot": "packages/demo/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/demo/dist",
          "main": "packages/demo/src/main.ts",
          "tsConfig": "packages/demo/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": false
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "options": {
          "buildTarget": "@ferment-ai/demo:build",
          "watch": false
        },
        "dependsOn": [{"projects": "self", "target": "build", "params": "forward"}]
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.11",
    "@ferment-ai/core-constructs-lib": "*",
    "@ferment-ai/core-constructs-runtime": "*",
    "@ferment-ai/runtime-common": "*",
    "@ferment-ai/runtime-in-memory": "*",
    "constructs": "^10.0.0"
  }
}
