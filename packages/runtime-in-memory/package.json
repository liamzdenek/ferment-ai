{
  "name": "@ferment-ai/runtime-in-memory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/runtime-in-memory/dist",
          "main": "packages/runtime-in-memory/src/index.ts",
          "tsConfig": "packages/runtime-in-memory/tsconfig.lib.json",
          "format": [
            "esm"
          ],
          "declarationRootDir": "packages/runtime-in-memory/src"
        }
      }
    }
  },
  "dependencies": {
    "@ferment-ai/runtime-interfaces": "*",
    "constructs": "^10.4.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30"
  }
}